# Copy to .env.local and fill in real values. Never commit .env.local.
# Same Supabase project as the web app's .env.example -- EXPO_PUBLIC_*
# vars are inlined into the client bundle the same way Next's
# NEXT_PUBLIC_* vars are, so only the anon key belongs here, never the
# service-role key.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
