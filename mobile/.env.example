# Copy to .env.local and fill in real values. Never commit .env.local.
# Same Supabase project as the web app's .env.example -- EXPO_PUBLIC_*
# vars are inlined into the client bundle the same way Next's
# NEXT_PUBLIC_* vars are, so only the anon key belongs here, never the
# service-role key.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The deployed web app's origin -- the Direct Access Pass checkout
# handoff and the payments webhook it posts to both live there (mobile
# has no server of its own). See mobile/lib/subscriptions/service.ts.
EXPO_PUBLIC_APP_URL=http://localhost:3000
