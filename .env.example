# Copy to .env.local and fill in real values. Never commit .env.local.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Supabase ---
# Local dev: run `supabase start` and use the printed local URL/keys.
# Production: create a hosted Supabase project and use its values instead.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (subscription: $5 / 30 days) ---
# No real provider is connected yet. PAYMENTS_PROVIDER=mock uses the
# dev-only mock provider (lib/payments/providers/mock.ts), which can never
# activate a production subscription. See docs/PAYMENTS.md.
PAYMENTS_PROVIDER=mock
PAYMENTS_WEBHOOK_SECRET=
# Example slots for a real future provider — leave unset until configured:
# ORANGE_MONEY_MERCHANT_ID=
# ORANGE_MONEY_API_KEY=
# MTN_MOMO_SUBSCRIPTION_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Email (optional; transactional notifications) ---
# Leave unset to disable email sending; in-app notifications still work.
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=

# --- Optional integrations (unconfigured by default) ---
SMS_PROVIDER=
MAPS_PROVIDER_API_KEY=
ANALYTICS_WRITE_KEY=
ERROR_MONITORING_DSN=
