# Copy to .env.local and fill in real values. Never commit .env.local.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Supabase ---
# Local dev: run `supabase start` and use the printed local URL/keys.
# Production: create a hosted Supabase project and use its values instead.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (subscription: $5 / 30 days) ---
# PAYMENTS_PROVIDER=mock uses the dev-only mock provider
# (lib/payments/providers/mock.ts), which can never activate a production
# subscription. See docs/PAYMENTS.md.
PAYMENTS_PROVIDER=mock
PAYMENTS_WEBHOOK_SECRET=

# MTN Mobile Money (MTN MoMo) Collection API -- set PAYMENTS_PROVIDER=mtn_momo
# to use it. Self-provisioned sandbox credentials: sign up at
# momodeveloper.mtn.com, subscribe to the free "Collection" product for a
# subscription key, then create an API user + API key against the sandbox
# (see lib/payments/providers/mtn-momo.ts). Liberia is a live MoMo
# production market, but the correct production X-Target-Environment
# value and real settlement currency (likely LRD, not the sandbox's EUR)
# are NOT yet confirmed -- see docs/PAYMENTS.md.
# MTN_MOMO_SUBSCRIPTION_KEY=
# MTN_MOMO_API_USER=
# MTN_MOMO_API_KEY=
# MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
# MTN_MOMO_TARGET_ENVIRONMENT=sandbox
# MTN_MOMO_CURRENCY=EUR

# Example slots for other future providers — leave unset until configured:
# ORANGE_MONEY_MERCHANT_ID=
# ORANGE_MONEY_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Email (optional; transactional notifications) ---
# Leave unset to disable email sending; in-app notifications still work.
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=

# --- Optional integrations (unconfigured by default) ---
SMS_PROVIDER=
MAPS_PROVIDER_API_KEY=
ANALYTICS_WRITE_KEY=
ERROR_MONITORING_DSN=
